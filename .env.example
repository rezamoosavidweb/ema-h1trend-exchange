# ============================================================
# EMA H1 Trend — Bybit Exchange Bot  |  Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Bybit credentials (REQUIRED) ─────────────────────────────
# Demo account: api-demo.bybit.com
BYBIT_API_KEY=rhiJwUa8HCiYjoS5wk
BYBIT_API_SECRET=wReAs1MOFFmroEyOXJDrylC6W226gUcekn5E

# Use testnet for testing before going live
BYBIT_TESTNET=false

# Use Bybit Demo Trading account (api-demo.bybit.com) — for paper trading
BYBIT_DEMO=true

# ── Symbol ───────────────────────────────────────────────────
# Bybit linear perpetual symbol (USDT-margined)
SYMBOL=BTCUSDT

# ── Position Sizing ──────────────────────────────────────────
#
# Model: margin-based (not SL-distance-based)
#
#   margin_per_trade = balance × RISK_PER_TRADE
#   qty              = (margin_per_trade × LEVERAGE) / entry_price
#
# Examples (balance = 1000 USDT, BTC entry = 80000):
#
#   RISK_PER_TRADE=0.01, LEVERAGE=1  → margin = 10 USDT → qty = 0.000125 BTC
#   RISK_PER_TRADE=0.01, LEVERAGE=5  → margin = 10 USDT → qty = 0.000625 BTC
#   RISK_PER_TRADE=0.02, LEVERAGE=10 → margin = 20 USDT → qty = 0.0025   BTC
#
# RISK_PER_TRADE: fraction of wallet committed as margin per trade (0.01 = 1%)
# LEVERAGE      : position size multiplier — margin stays constant, notional scales
#
RISK_PER_TRADE=0.01        # 1% of wallet as margin per trade
LEVERAGE=1                 # Leverage multiplier (1 = no leverage)

RR=1.0                     # TP:SL distance ratio (1.0 = 1:1)

# Optional overrides (auto-detected from symbol if blank)
# PIP_SIZE=1.0             # BTC=1.0, ETH=0.01, XRP=0.0001, etc.
# MAGIC=20260510            # Auto-derived from symbol if blank

# ── Advanced strategy parameters ─────────────────────────────
LOOKBACK_BARS=5            # Bars in the swing window (HH/LL lookback)
PENDING_OFFSET_TICKS=3.0   # Ticks beyond swing boundary for entry price
PENDING_EXPIRY_MIN=60      # Cancel pending order after N minutes
ENTRY_TF_MINUTES=5         # Entry timeframe in minutes

# ── Execution ─────────────────────────────────────────────────
DRY_RUN=false              # true = log signals only, no real orders
POSITION_MODE=one_way      # one_way | hedge
REPLACE_PENDING=false      # Cancel existing pending before placing new

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false             # true = JSON log lines (for Loki/ELK/Datadog)
# LOG_FILE=logs/bot.log    # Uncomment to also write to file

# ── Signal audit log ──────────────────────────────────────────
# SIGNAL_LOG_CSV=logs/signals.csv   # Append strategy signals to CSV

# ── Data fetch sizes ──────────────────────────────────────────
# BARS_ENTRY=600            # M5 bars (includes 200-bar EMA warmup)
# BARS_TREND=350            # H1 bars (includes 200-bar EMA warmup)

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=8313609248:AAH0i5z-0lJS7MVulFHKXf0IcWPSqKjh5FY
TELEGRAM_CHAT_ID=-1002383929199
TELEGRAM_API_ID = 27396957
TELEGRAM_API_HASH = '53e16a90d89a28a0a67bb95ca3dff324'

# ── Fee ─────────────────────────────────────────────
ENTRY_FEE_RATE=0.0002
EXIT_FEE_RATE=0.00055

# FEE_TIGHTEN_SL: SL را به اندازه fee_per_unit نزدیک‌تر کنید
#   qty بر اساس SL اصلی محاسبه می‌شه → net_loss در SL = RISK_FIXED_USDT
#   (با FEE_ADJUSTED_SIZING جمع نشود — این اولویت دارد)
FEE_TIGHTEN_SL=true
FEE_ADJUSTED_SIZING=false

# ── ATR minimum SL ───────────────────────────────────
# ATR_MIN_SL_ENABLED: اگر true باشد، SL نمی‌تواند از ATR×multiplier تنگ‌تر باشد
# وقتی SL گشادتر می‌شود، TP هم بر اساس RR محاسبه مجدد می‌شود
ATR_MIN_SL_ENABLED=false
ATR_PERIOD=14
ATR_MIN_SL_MULTIPLIER=1.0
